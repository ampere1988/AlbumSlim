    "所有 AI 分析均在您的设备上完成，照片和视频绝不会上传到任何服务器": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All AI analysis is done on your device. Photos and videos are never uploaded to any server."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
