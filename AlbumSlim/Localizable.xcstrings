    "您的相册可能积累了不少新照片，来看看有哪些可以清理吧": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your album may have accumulated new photos. Check what can be cleaned up."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
