          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 AI 분석은 기기에서 이루어지며 사진과 동영상은 어떤 서버에도 업로드되지 않습니다"
          }
        },
        "es": {
          "stringUnit": {
