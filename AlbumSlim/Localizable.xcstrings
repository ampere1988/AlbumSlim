    "这些相册由对应 App 自动保存，通常是占空间最快的一类。" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Alben werden automatisch von den jeweiligen Apps gespeichert und wachsen meist am schnellsten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These albums are saved automatically by their apps and usually grow the fastest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos álbumes se guardan automáticamente por sus apps y suelen ser los que más rápido crecen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
